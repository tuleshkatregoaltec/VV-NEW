{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"generate-client": "openapi-ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"biome:check": "biome check --diagnostic-level=error",
		"biome:write": "biome check --write",
		"format": "bun run biome:write -- .",
		"lint": "bun run biome:check -- .",
		"style:audit": "node scripts/style-audit.mjs",
		"precommit": "bun ./scripts/precommit-biome.mjs",
		"test": "vitest run",
		"test:unit": "vitest run tests/unit src/lib",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.6",
		"@hey-api/openapi-ts": "0.94.0",
		"@sveltejs/adapter-cloudflare": "^7.2.4",
		"@sveltejs/adapter-vercel": "^6.0.0",
		"@sveltejs/kit": "^2.47.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.16",
		"@types/dompurify": "^3.2.0",
		"@types/maplibre-gl": "^1.14.0",
		"@types/node": "^24",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^4.1.16",
		"typescript": "^5.9.3",
		"vite": "^7.1.10",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"@stripe/stripe-js": "^8.6.3",
		"@supabase/auth-js": "^2.90.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@tanstack/svelte-query": "^6.0.8",
		"@zxcvbn-ts/core": "^3.0.4",
		"bun": "^1.3.4",
		"chart.js": "^4.5.1",
		"dompurify": "^3.3.1",
		"lucide-svelte": "^0.562.0",
		"maplibre-gl": "^5.16.0",
		"marked": "^17.0.3",
		"nanoid": "^5.1.6",
		"posthog-js": "^1.298.0",
		"xlsx": "^0.18.5",
		"zxcvbn": "^4.4.2"
	}
}
