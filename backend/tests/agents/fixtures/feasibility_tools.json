  "replace_unit_mix": {
    "description": "Replace the full unit mix with exactly the listed unit types.",
    "schema": {
      "$defs": {
        "WorkspaceUnitMixReplacement": {
          "properties": {
            "avgSizeSqm": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "count": {
              "minimum": 0,
              "type": "integer"
            },
            "parkingRatio": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "price_sqm": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "type": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "count",
            "avgSizeSqm"
          ],
          "title": "WorkspaceUnitMixReplacement",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "unit_mix": {
          "items": {
            "$ref": "#/$defs/WorkspaceUnitMixReplacement"
          },
          "type": "array"
        }
      },
      "required": [
        "unit_mix"
      ],
      "type": "object"
    }
  },
