# Runtime
ENVIRONMENT=production

# Database (configMap)
POSTGRES_URL=postgresql+asyncpg://user:password@host:5432/database

# Redis (configMap for URL, Bitwarden for password)
REDIS_URL=redis://host:6379
REDIS_PASSWORD=your-redis-password

# ClickHouse Analytics (configMap for connection, Bitwarden for password)
CLICKHOUSE_HOST=clickhouse-host
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=vitevue
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_DATABASE=vitevue
CLICKHOUSE_SECURE=false

# Authentication (configMap for URL, Bitwarden for service-role key)
AUTH_URL=https://your-auth-url.com/auth/v1
AUTH_SERVICE_ROLE_KEY=your-auth-service-role-key
# Optional: only needed by local scripts that create a human admin user.
FIRST_SUPERUSER=
FIRST_SUPERUSER_PASSWORD=
FIRST_SUPERUSER_RENAME_FROM=
FIRST_SUPERUSER_FIRST_NAME=Admin
FIRST_SUPERUSER_LAST_NAME=User
FIRST_SUPERUSER_AVATAR_URL=

# Security (Bitwarden)
SESSION_SECRET=your-session-secret-at-least-32-characters-long
SERVICE_API_KEY=your-service-api-key-at-least-32-characters-long

# CORS (configMap)
FRONTEND_URL=https://your-frontend.com
PUBLIC_API_BASE_URL=https://api.your-backend.com
ALLOWED_ORIGINS='["https://your-frontend.com"]'

# Object storage (configMap for provider/endpoint/bucket, Bitwarden for keys)
OBJECT_STORAGE_PROVIDER=r2
OBJECT_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=your-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
OBJECT_STORAGE_BUCKET=your-bucket-name
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_USE_PATH_STYLE=true

# Stripe (Bitwarden for keys, configMap for price IDs)
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID_TIER1=price_tier1_id
STRIPE_PRICE_ID_TIER2=price_tier2_id
FRONTEND_SUCCESS_URL=https://your-frontend.com/payment-success
FRONTEND_CANCEL_URL=https://your-frontend.com/payment-cancel

# OpenRouter AI (Bitwarden for key, configMap for model)
OPENROUTER_API_KEY=your-openrouter-api-key
DEFAULT_CHAT_MODEL=google/gemini-3-flash-preview

# PostHog Analytics (Bitwarden for key, configMap for host)
POSTHOG_API_KEY=your-posthog-api-key
POSTHOG_HOST=https://us.i.posthog.com

# Error Tracking (Bitwarden)
HONEYBADGER_API_KEY=your-honeybadger-api-key
LOGFIRE_TOKEN=
