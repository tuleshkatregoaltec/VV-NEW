# Production secrets and external endpoints for the ph-box.
# All values here come from Bitwarden — pull with: just env
#
# Structural config (service names, ports, provider choices, policy flags)
# lives in docker-compose.yml, not here.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://vitevue:password@host.docker.internal:5432/vitevue

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── Security ──────────────────────────────────────────────────────────────────
SESSION_SECRET=
SERVICE_API_KEY=

# ── Auth (GoTrue) ─────────────────────────────────────────────────────────────
AUTH_SERVICE_ROLE_KEY=
GOTRUE_JWT_SECRET=
GOTRUE_DB_DATABASE_URL=postgres://supabase_auth_admin:password@host.docker.internal:5432/vitevue
API_EXTERNAL_URL=https://auth.your-domain.com
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=noreply@your-domain.com

# ── URLs (used by both backend and auth) ─────────────────────────────────────
# GOTRUE_SITE_URL and GOTRUE_URI_ALLOW_LIST are set to ${FRONTEND_URL} in
# docker-compose.yml — only one entry needed here.
FRONTEND_URL=https://your-frontend.pages.dev
PUBLIC_API_BASE_URL=https://api.your-domain.com
FRONTEND_SUCCESS_URL=https://your-frontend.pages.dev/payment-success
FRONTEND_CANCEL_URL=https://your-frontend.pages.dev/payment-cancel

# ── ClickHouse ────────────────────────────────────────────────────────────────
# Host/port/user/database/secure are set in docker-compose.yml.
CLICKHOUSE_PASSWORD=

# ── Object storage ────────────────────────────────────────────────────────────
# Provider/region/path-style are set in docker-compose.yml.
OBJECT_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_TIER1=
STRIPE_PRICE_ID_TIER2=

# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── auth-db-init (first deploy only) ─────────────────────────────────────────
# Credentials for the Postgres superuser that creates the auth role.
POSTGRES_USER=vitevue
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────────
HONEYBADGER_API_KEY=
LOGFIRE_TOKEN=
POSTHOG_API_KEY=
IMAGE_TAG=latest

# Optional content-free LangSmith telemetry (never enabled automatically).
AI_TELEMETRY_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
