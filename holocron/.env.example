# Holocron VPS secrets and external endpoints.
# All values here come from Bitwarden — pull with: just env
#
# Structural config (Dagster Postgres URL, provider choices, ClickHouse port/db/secure)
# lives in docker-compose.yml, not here.

# ── ClickHouse (ph-box, native) ───────────────────────────────────────────────
CLICKHOUSE_HOST=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# ── Object storage ────────────────────────────────────────────────────────────
OBJECT_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PUBLIC_URL_BASE=

# ── Platform database (for publishing jobs) ───────────────────────────────────
PLATFORM_POSTGRES_URL=

# ── Source credentials ────────────────────────────────────────────────────────
REELLY_EMAIL=
REELLY_PASSWORD=
TWOCAPTCHA_API_KEY=

# ── News ingestion ────────────────────────────────────────────────────────────
NEWS_FEED_URLS=

# DXBI evidence: scraper output root (<dir>/{rentals,sales}/run=<date>/ with _SUCCESS)
DXBI_EVIDENCE_DIR=
