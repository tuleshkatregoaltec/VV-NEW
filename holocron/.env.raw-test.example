# Raw-only smoke test against object storage.
# Structural config (Dagster Postgres URL, provider choices, ClickHouse port/db/secure)
# lives in docker-compose.yml and docker-compose.raw-test.yml.

# ── Object storage ────────────────────────────────────────────────────────────
OBJECT_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PUBLIC_URL_BASE=

# ── ClickHouse ────────────────────────────────────────────────────────────────
# Raw-only tests do not connect to ClickHouse. Set real values to test bronze.
CLICKHOUSE_HOST=unused
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=unused

# ── Optional source credentials ───────────────────────────────────────────────
REELLY_EMAIL=
REELLY_PASSWORD=
TWOCAPTCHA_API_KEY=

# ── Optional news ingestion ───────────────────────────────────────────────────
PLATFORM_POSTGRES_URL=
NEWS_FEED_URLS=
