# Local Dagster metadata storage
DAGSTER_POSTGRES_URL=postgresql://dagster:dagster@postgres:5432/dagster

# Local MinIO-backed object storage
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_ACCESS_KEY_ID=minio
OBJECT_STORAGE_SECRET_ACCESS_KEY=minio123
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=vitevue-etl
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_USE_PATH_STYLE=true
OBJECT_STORAGE_PUBLIC_URL_BASE=

# Local ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=vitevue
CLICKHOUSE_SECURE=false

# Source configuration
REELLY_EMAIL=
REELLY_PASSWORD=
TWOCAPTCHA_API_KEY=

# Platform news ingestion
PLATFORM_POSTGRES_URL=
NEWS_FEED_URLS=
NEWS_THUMBNAIL_PREFIX=media/news/thumbnails

# DXBI evidence: scraper output root (<dir>/{rentals,sales}/run=<date>/ with _SUCCESS)
DXBI_EVIDENCE_DIR=
